<Project Sdk="Microsoft.NET.Sdk">

  <!-- The lab: StabilityLab's load engine (CUDA driver API, kernels as PTX the driver compiles, every result checked bit
       for bit on the CPU) as a process of its own, so a GPU that hangs takes the load down and not the MCP server or the
       service. It reads the card through NVML only and writes nothing: a sweep's trials go through the broker. Not in
       Clocktail.sln, like the other tools. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Clocktail.Domain\Clocktail.Domain.csproj" />
  </ItemGroup>

  <!-- The soloist (Kernels/solo.cu, from Etude): its PTX is built by Kernels/build_solo.py and embedded as it is. -->
  <ItemGroup>
    <EmbeddedResource Include="Kernels\solo.ptx" LogicalName="solo.ptx" />
    <EmbeddedResource Include="..\Blackwell\kernels\images\compute\c01_fp32_fma_checkpoint8.ptx;..\Blackwell\kernels\images\compute\c01_fp32_fma_checkpoint8.sm_120.cubin"
                      LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>clocktail-lab</AssemblyName>
    <RootNamespace>Clocktail.Lab</RootNamespace>
  </PropertyGroup>

</Project>
