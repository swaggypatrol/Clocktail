<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MCP server for tuning the curve live in a game (stdio). Not elevated: it reads the card itself, as the tray
       does, and sends every write to the broker, which holds every limit. Not in Clocktail.sln, like the other tools. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Clocktail.Core\Clocktail.Core.csproj" />
    <ProjectReference Include="..\..\src\Clocktail.Domain\Clocktail.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <!-- The agent's manual (ManualTools): one topic per file, instructions.md is what every agent gets on connecting. -->
  <ItemGroup>
    <EmbeddedResource Include="Manual\*.md" LogicalName="manual.%(Filename).md" />
  </ItemGroup>

  <!-- Two builds: net10.0 for the tests (they run on Linux too), net10.0-windows for the released server, which adds the
       V/F curve editor window (curve_editor, WinForms). release.sh publishes the windows one. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>clocktail-mcp</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <!-- WinForms' implicit usings would make Timer and friends ambiguous in the rest of the server: the window names its own. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
